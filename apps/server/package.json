{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "generate:module": "bun run scripts/generate-module.ts",
    "rename:symbol": "bun run scripts/rename-symbol.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/openapi": "^1.4.15",
    "elysia": "^1.2.10"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "ts-morph": "^28.0.0"
  }
}
